meta {
  name: annotate greek
  type: http
  seq: 4
}

post {
  url: {{base}}/annotate
  body: json
  auth: inherit
}

body:json {
  {
    "document": {
      "@context": [
        "http://vocab.lappsgrid.org/context-1.0.0.jsonld",
        {
          "lexvo": "http://lexvo.org/id/iso639-3/"
        }
      ],
      "text": {
        "@value": "πῆναξ σὺν θεῶ ἁγ(ίας) τῆς βίβλου ταύτης. πῆναξ σὺν θεῶ ἁγ(ίας) τῆς βίβλου ταύτης",
        "@language": "lexvo:grc"
      }
    },
    "annotators": [
      "sentence-split",
      "sentence-count",
      "colinmodel"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
