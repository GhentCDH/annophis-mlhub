meta {
  name: annotate dummy text
  type: http
  seq: 2
}

post {
  url: {{base}}/annotate
  body: json
  auth: inherit
}

body:json {
  {
    "document": {
      "@context": [
        {
          "lexvo": "http://lexvo.org/id/iso639-3/"
        }
      ],
      "text": {
        "@value": "My name is Neil Peeters and i was born on 25th April 2002. Now, i work at GhentCDH, which is in Ghent.",
        "@language": "lexvo:en"
      }
    },
    "annotators": [
      "sentence-split",
      "sentence-count",
      "dummy-ner"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
