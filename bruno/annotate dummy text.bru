meta {
  name: annotate dummy text
  type: http
  seq: 2
}

post {
  url: {{base}}/annotate
  body: json
  auth: inherit
}

body:json {
  {
    "document": {
      "text": "My name is Neil Peeters and i was born on 25th April 2002. Now, i work at GhentCDH, which is in Ghent.",
      "meta": {
        "lang": "en"
      }
    },
    "annotators": [
      "sentence-split",
      "sentence-count",
      "dummy-ner"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
